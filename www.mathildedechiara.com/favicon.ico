    <head>
        <meta charset="UTF-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="theme-color" content="#f7f5f2" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0, viewport-fit=cover"
        />
        <!-- Static shell only. The build's prerender pass writes the real
             per-route tags into dist/<route>/index.html, each carrying
             data-rh so react-helmet-async adopts rather than duplicates
             them. Nothing page-specific belongs here: a static description
             would survive alongside the per-page one and ship two to
             crawlers. -->
        <!-- Data (apicdn) and images (cdn) both come from Sanity. Warm the
             connections while the JS bundle is still downloading. -->
        <link rel="preconnect" href="https://b2mcdo5v.apicdn.sanity.io" crossorigin />
        <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
        <!-- The intro name/role reveal renders in Regular + the counter in
             Ultralight on the very first paint, so preload both. -->
        <link rel="preload" href="/fonts/PPEditorialNew-Regular.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/PPEditorialNew-Ultralight.woff2" as="font" type="font/woff2" crossorigin />
      <script type="module" crossorigin src="/assets/index-D88q76o1.js"></script>
